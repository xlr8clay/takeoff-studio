# Copy to .env (never commit .env). Leave DATABASE_URL unset to use embedded PGlite locally.

# Production / Render Postgres (placeholders - get the real value from the Render dashboard):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# SSL is on by default (rejectUnauthorized:false); set false only for a local non-SSL Postgres
# DATABASE_SSL=true
# DB_POOL_MAX=5

# Local embedded Postgres (used when DATABASE_URL is unset); "memory" = throwaway in-memory DB
PGLITE_DIR=./.pglite

# Shared gate for the studio. Required when NODE_ENV=production. Never commit the real value.
# APP_PASSWORD=

# The in-page Ask AI button talks to claude.ai when the page is opened there.
# This server does not call Anthropic. Set a key only if you add that later.
# ANTHROPIC_API_KEY=

# Set to 0 to skip loading the studio job files on startup (migrate and seed still run).
# STUDIO_IMPORT=1
